{
    "manifest_version": 3,
    "name": "Ctrl+S Tube - YouTube Downloader",
    "version": "2.0.0",
    "description": "Download YouTube videos and audio with ease. Save as easily as Ctrl+S!",
    "author": "Ctrl+S Tube Team",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Ctrl+S Tube"
    },
    "permissions": [
        "downloads",
        "storage",
        "activeTab",
        "contextMenus"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://i.ytimg.com/*",
        "https://img.youtube.com/*"
    ],
    "optional_host_permissions": [
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "https://www.youtube.com/*",
                "https://m.youtube.com/*"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://i.ytimg.com https://img.youtube.com; connect-src 'self' https://www.youtube.com https://i.ytimg.com;"
    },
    "minimum_chrome_version": "88",
    "offline_enabled": false
}